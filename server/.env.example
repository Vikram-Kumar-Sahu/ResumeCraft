# ─── Server ─────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB Atlas ───────────────────────────────────────────────
# Get free cluster at mongodb.com/atlas
MONGODB_URI=mongodb+srv://showmyth:<db_password>@resumecraft.z68zvn1.mongodb.net/?appName=ResumeCraft

# ─── JWT ─────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ─── Client URL (React dev server) ──────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── OpenRouter ────────────────────────────────────────────────────
# Get a key at openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here
# Defaults to "openrouter/free" — OpenRouter's own router that picks a
# currently-available free model automatically, so this keeps working
# even as their free-tier lineup changes. Pin a specific model instead
# (e.g. meta-llama/llama-3.1-8b-instruct:free) for consistent behavior —
# see openrouter.ai/models?max_price=0 for the current free list.
OPENROUTER_MODEL=openrouter/free

# ─── Stripe Payments ─────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_YEARLY_PRICE_ID=price_...

# ─── LaTeX compile hardening ──────────────────────────────────────
# Max pdflatex processes running at once (default 4)
LATEX_MAX_CONCURRENCY=4
# Max requests allowed to wait for a free slot before rejecting with 503 (default 30)
LATEX_MAX_QUEUE=30
# Hard timeout per compile in ms before killing the process (default 15000)
LATEX_COMPILE_TIMEOUT_MS=15000
# Optional: if set, LaTeX compiling is coordinated through a Redis-backed
# queue (BullMQ) instead of in-process memory — needed if you run more
# than one server instance, so concurrency is capped cluster-wide rather
# than per-instance. Leave unset for a single-instance deployment; the
# in-process queue above is used automatically as a safe default.
# REDIS_URL=redis://localhost:6379

# ─── Email (password reset, welcome email) ───────────────────────
# Generic SMTP — works with Gmail, SendGrid SMTP relay, AWS SES SMTP,
# Mailtrap (dev), Postmark, etc. If SMTP_HOST is unset, emails are
# logged instead of sent — safe default for local dev, never crashes.
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password
# SMTP_FROM="ResumeCraft <no-reply@resumecraft.app>"

# ─── Error monitoring (optional) ──────────────────────────────────
# If unset, the app logs locally via Winston only (console + logs/*.log)
# — this is a safe, fully-functional default. Set SENTRY_DSN to also
# report exceptions to Sentry for alerting in production.
# SENTRY_DSN=https://xxxxx@oXXXXXX.ingest.sentry.io/XXXXXXX
LOG_LEVEL=info

